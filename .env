# ── Energy Intelligence Dashboard — Environment Variables ──────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. Add .env to .gitignore.

# EIA API Key (free at https://www.eia.gov/opendata/)
EIA_API_KEY=HatP28hhlZ3uF1Ti9nw13FjN1oUjVf0PUWmcHUed

# Optional: Rate-limit window in seconds (default 900 = 15 minutes)
RATE_LIMIT_WINDOW=900

# Optional: Max run attempts per window per session (default 5)
RATE_LIMIT_MAX_ATTEMPTS=5

# Optional: Max payload / request body size in bytes (default 65536 = 64 KB)
MAX_PAYLOAD_BYTES=65536
